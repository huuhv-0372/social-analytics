# Copy file này thành .env và điền giá trị. KHÔNG commit file .env.

# MySQL
DB_HOST=localhost
# Port MySQL mở ra máy host (33069 để tránh trùng MySQL cài sẵn ở 3306). App chạy trong Docker không dùng giá trị này.
DB_PORT=33069
DB_NAME=social_analytics
DB_USERNAME=social_analytics
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Port app mở ra máy host khi chạy bằng docker compose
APP_PORT=8080
# Profile của container app (mặc định dev: bật Swagger UI, log DEBUG). Đặt profile khác (vd prod) để chạy cấu hình production-safe.
SPRING_PROFILES_ACTIVE=dev
# Chỉ đặt "native" khi app chạy sau reverse proxy / load balancer tin cậy (kết thúc HTTPS, gửi X-Forwarded-*).
# Để trống khi truy cập app trực tiếp — bật khi không có proxy thì client giả được scheme/host.
FORWARD_HEADERS_STRATEGY=

# Key AES-256 mã hoá access token Facebook/X lưu DB (bắt buộc — trống/sai thì app không khởi động).
# Sinh bằng: openssl rand -base64 32  (Base64 của đúng 32 byte). Đổi key → token đã lưu không dùng được, user đăng nhập lại.
TOKEN_ENCRYPTION_KEY=

# OAuth2 Facebook (bắt buộc — trống thì app không khởi động). Tạo app ở https://developers.facebook.com,
# khai báo Valid OAuth Redirect URI: http://localhost:8080/login/oauth2/code/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# OAuth2 X/Twitter (bắt buộc — trống thì app không khởi động). Tạo app ở https://developer.x.com (User authentication
# settings: Type = Web App, Automated App or Bot), Callback URI: http://localhost:8080/login/oauth2/code/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Cookie session chỉ gửi qua HTTPS (mặc định true). Profile dev/test mặc định false (HTTP localhost); production chạy HTTPS thì để true.
# SESSION_COOKIE_SECURE=true

# ActiveMQ Artemis
# Profile dev mặc định dùng broker embedded (trong JVM). Đặt native để app chạy bằng JDK local kết nối broker của
# docker compose (docker compose up -d mysql artemis). Container app của compose luôn dùng native.
# ARTEMIS_MODE=native
ARTEMIS_HOST=localhost
ARTEMIS_PORT=61616
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=
